---
// Sticker-style illustrations, defined once and reused with <use> everywhere
// (cards, request bar, form list, fly-to-bar animation). Decorative only.
const star = (cx: number, cy: number, R: number) => {
  const r = R * 0.45;
  const pts: string[] = [];
  for (let i = 0; i < 10; i++) {
    const a = (Math.PI / 5) * i - Math.PI / 2;
    const rad = i % 2 === 0 ? R : r;
    pts.push(`${(cx + rad * Math.cos(a)).toFixed(1)},${(cy + rad * Math.sin(a)).toFixed(1)}`);
  }
  return pts.join(' ');
};
