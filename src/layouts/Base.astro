---
import '@fontsource-variable/fredoka/wght.css';
import '../styles/global.css';
import fredokaLatin from '@fontsource-variable/fredoka/files/fredoka-latin-wght-normal.woff2?url';
import { seo, localBusinessJsonLd } from '../data/site';

interface Props { title: string; description: string }
const { title, description } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!seo.indexable && <meta name="robots" content="noindex,nofollow" />}
    <script type="application/ld+json" set:html={JSON.stringify(localBusinessJsonLd())} />
    <meta name="theme-color" content="#1a0b2e" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <link rel="preload" href={fredokaLatin} as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a class="skip-link" href="#top">Skip to content</a>
    <div class="demo-banner" role="note">
      Demo preview built for Leaps of Laughter. Sample photos will be replaced with your own.
    </div>
    <slot />
  </body>
</html>
