---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ArtSprite from '../components/ArtSprite.astro';
import Confetti from '../components/Confetti.astro';
import heroPhoto from '../assets/hero.webp';
import laughPhoto from '../assets/collage-laugh.webp';
import balloonPhoto from '../assets/collage-balloons.webp';
import bandPhoto from '../assets/party-band.webp';
import { business, contacts, serviceAreas, categories, rentals } from '../data/site';

const catLabel = Object.fromEntries(categories.map((c) => [c.id, c.label]));
const catCount = Object.fromEntries(categories.map((c) => [c.id, rentals.filter((r) => r.category === c.id).length]));
const money = (n: number) => `$${n}`;
const word = 'unforgettable'.split('');
---
<Base
  title="Leaps of Laughter | Party rentals in Plant City, FL"
  description="Bounce houses, water slides, games and add-ons from Leaps of Laughter LLC in Plant City, FL. Pick your rentals and request a date."
>
  <ArtSprite />

  <!-- Floating header (zero-height sticky wrapper so it overlays the hero) -->
  <div class="header-wrap" data-header-wrap>
    <header class="site-header container" data-header>
      <a class="brand" href="#top" aria-label="Leaps of Laughter, back to top">
        <svg viewBox="0 0 40 40" width="38" height="38" aria-hidden="true"><rect width="40" height="40" rx="12" fill="#ffc933"/><path d="M8 25c0-9 5-14 12-14s12 5 12 14" fill="none" stroke="#1a0b2e" stroke-width="4.5" stroke-linecap="round"/><circle cx="20" cy="29" r="3.4" fill="#ff4d4d"/></svg>
        <span>Leaps of Laughter</span>
      </a>
      <nav class="nav" id="site-nav" aria-label="Main" data-nav>
        <a href="#rentals">Rentals</a>
        <a href="#how">How it works</a>
        <a href="#areas">Service areas</a>
        <a href="#request">Request</a>
        <a href="#contact">Contact</a>
      </nav>
      <a class="btn btn-yellow btn-sm header-cta" href="#request">Request a date</a>
      <button type="button" class="menu-btn" aria-expanded="false" aria-controls="site-nav" data-menu>
        <span class="sr-only">Menu</span>
        <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path class="menu-open" d="M4 7h16M4 12h16M4 17h16" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"/><path class="menu-close" d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"/></svg>
      </button>
    </header>
  </div>

  <main>
    <!-- HERO -->
    <section class="hero" id="top">
      <div class="hero-glow" aria-hidden="true"></div>
      <div class="container hero-grid">
        <div class="hero-copy">
          <p class="eyebrow-pill">{business.kind} · {business.city}</p>
          <h1>
            Make their party<br />
            <span class="bouncy"><span class="sr-only">unforgettable</span><span aria-hidden="true">{word.map((ch, i) => <span class="ch" style={`--i:${i}`}>{ch}</span>)}</span>
              <svg class="squiggle" viewBox="0 0 300 16" preserveAspectRatio="none" aria-hidden="true"><path d="M3 9c18-10 30 8 48 0s30-10 48 0 30 8 48 0 30-10 48 0 30 8 48 0 30-10 48 0" fill="none" stroke="#5ad1f2" stroke-width="5" stroke-linecap="round"/></svg>
            </span>
          </h1>
          <p class="lead">{business.tagline}</p>
          <div class="cta-row">
            <a class="btn btn-yellow btn-lg" href="#rentals">See rentals</a>
            <a class="btn btn-ghost btn-lg" href="#request">Request a date</a>
          </div>
          <p class="trust">
            <a class="fb-pill" href={business.facebook} target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M7 11v9H4a1 1 0 0 1-1-1v-7a1 1 0 0 1 1-1zm2 9V11l4-8c1.7 0 3 1.3 3 3v3h4.3a1.7 1.7 0 0 1 1.7 2l-1.3 7.4A2.5 2.5 0 0 1 18.3 20z" fill="#ffc933"/></svg>
              <span>{business.facebookLine}</span><span class="sr-only"> (opens Facebook in a new tab)</span>
            </a>
          </p>
        </div>

        <div class="collage" data-parallax>
          <svg class="rainbow" viewBox="0 0 400 210" aria-hidden="true"><path d="M20 200a180 180 0 0 1 360 0" fill="none" stroke="#ff4d4d" stroke-width="22" opacity=".9"/><path d="M46 200a154 154 0 0 1 308 0" fill="none" stroke="#ffc933" stroke-width="22" opacity=".9"/><path d="M72 200a128 128 0 0 1 256 0" fill="none" stroke="#5ad1f2" stroke-width="22" opacity=".9"/></svg>
          <div class="c-arch" data-depth="14">
            <Image src={heroPhoto} alt="A little girl with colorful paint on her face looks up and smiles" widths={[260, 400, 520]} sizes="(min-width: 900px) 260px, 56vw" format="webp" quality={68} loading="eager" fetchpriority="high" decoding="async" />
          </div>
          <div class="c-circle" data-depth="-10">
            <Image src={laughPhoto} alt="A toddler in a cap laughing out loud" widths={[140, 220, 300]} sizes="(min-width: 900px) 160px, 34vw" format="webp" quality={62} loading="eager" decoding="async" />
          </div>
          <div class="c-blob" data-depth="8">
            <Image src={balloonPhoto} alt="Colorful balloons floating up with ribbons hanging down" widths={[140, 220, 300]} sizes="(min-width: 900px) 150px, 32vw" format="webp" quality={62} loading="eager" decoding="async" />
          </div>
          <svg class="badge" viewBox="0 0 120 120" aria-hidden="true">
            <defs><path id="badge-circle" d="M60 60m-45 0a45 45 0 1 1 90 0a45 45 0 1 1-90 0" /></defs>
            <circle cx="60" cy="60" r="58" fill="#ffc933" stroke="#1a0b2e" stroke-width="3" />
            <g class="badge-spin"><text font-size="11.5" font-weight="600" fill="#1a0b2e"><textPath href="#badge-circle" textLength="278" lengthAdjust="spacing">PARTY RENTALS • PLANT CITY, FL • </textPath></text></g>
            <path d="M60 38l6.5 14.5 15.5 1.6-11.6 10.4 3.4 15.5L60 72l-13.8 8 3.4-15.5L38 54.1l15.5-1.6z" fill="#ff4d4d" stroke="#1a0b2e" stroke-width="3" stroke-linejoin="round" />
          </svg>
          <Confetti />
        </div>
      </div>
      <div class="scallop scallop-bottom" aria-hidden="true"></div>
    </section>

    <!-- MARQUEE: real inventory + prices -->
    <div class="marquee" role="group" aria-label="Rentals and prices">
      <div class="marquee-track">
        <ul class="marquee-list">
          {rentals.map((r) => <li>{r.name} <b>{money(r.price)}</b></li>)}
        </ul>
        <ul class="marquee-list" aria-hidden="true">
          {rentals.map((r) => <li>{r.name} <b>{money(r.price)}</b></li>)}
        </ul>
      </div>
    </div>

    <!-- RENTALS -->
    <section class="section sec-rentals" id="rentals" aria-labelledby="rentals-h">
      <div class="container">
        <div class="section-head reveal">
          <p class="eyebrow-pill eyebrow-pill-dark">Our inventory</p>
          <h2 id="rentals-h">Pick a <span class="mark">rental</span></h2>
          <p class="sub">Tap “Add to my request” on anything you like, then send it all in one go.</p>
        </div>

        <div class="chips reveal" role="group" aria-label="Filter rentals">
          <button type="button" class="chip" data-filter="all" aria-pressed="true">All <span class="chip-n">{rentals.length}</span></button>
          {categories.map((c) => (
            <button type="button" class="chip" data-filter={c.id} aria-pressed="false">{c.label} <span class="chip-n">{catCount[c.id]}</span></button>
          ))}
        </div>
        <p class="sr-only" id="filter-status" role="status" aria-live="polite"></p>

        <ul class="grid" id="grid">
          {rentals.map((r) => (
            <li class="card reveal" data-rental data-id={r.id} data-name={r.name} data-price={r.price} data-cat={r.category} data-art={r.art}>
              <div class="art">
                <svg class="art-svg" viewBox="0 0 400 280" aria-hidden="true" focusable="false"><use href={`#art-${r.art}`} /></svg>
                <p class="tag">{catLabel[r.category]}</p>
                <p class="price-sticker"><span class="sr-only">Price: </span>{money(r.price)}</p>
              </div>
              <div class="card-body">
                <h3>{r.name}</h3>
                {r.specs.length > 0 && (
                  <ul class="specs" aria-label={`${r.name} size`}>
                    {r.specs.map((s) => <li>{s}</li>)}
                  </ul>
                )}
                {r.note && <p class="note">{r.note}</p>}
                <button type="button" class="btn btn-add" data-add aria-pressed="false">
                  <svg class="add-icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path class="i-plus" d="M12 5v14M5 12h14" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round"/><path class="i-check" d="M5 12.5l4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  <span class="add-label">Add to my request</span>
                </button>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- HOW IT WORKS -->
    <section class="section sec-how edge-top" id="how" aria-labelledby="how-h">
      <div class="container">
        <div class="section-head reveal">
          <p class="eyebrow-pill eyebrow-pill-navy">Simple as 1, 2, 3</p>
          <h2 id="how-h">How it works</h2>
        </div>
        <ol class="steps">
          <li class="step reveal">
            <span class="step-num" aria-hidden="true">1</span>
            <svg class="step-icon" viewBox="0 0 24 24" width="40" height="40" aria-hidden="true"><path d="M12 2.5l2.9 6 6.6.8-4.9 4.5 1.3 6.5L12 17l-5.9 3.3 1.3-6.5L2.5 9.3l6.6-.8z" fill="#ffc933" stroke="#1a0b2e" stroke-width="1.8" stroke-linejoin="round"/></svg>
            <h3>Choose</h3>
            <p>Browse the rentals and tap “Add to my request” on everything you want.</p>
          </li>
          <li class="step reveal">
            <span class="step-num" aria-hidden="true">2</span>
            <svg class="step-icon" viewBox="0 0 24 24" width="40" height="40" aria-hidden="true"><path d="M3 11.5L21 3l-6.5 18-3.4-7.3z" fill="#5ad1f2" stroke="#1a0b2e" stroke-width="1.8" stroke-linejoin="round"/><path d="M11.1 13.7L21 3" fill="none" stroke="#1a0b2e" stroke-width="1.8" stroke-linecap="round"/></svg>
            <h3>Send a request</h3>
            <p>Tell us your event date, ZIP code and any notes, then send it.</p>
          </li>
          <li class="step reveal">
            <span class="step-num" aria-hidden="true">3</span>
            <svg class="step-icon" viewBox="0 0 24 24" width="40" height="40" aria-hidden="true"><path d="M4 4.5h16v11H9.5L4 20z" fill="#ff4d4d" stroke="#1a0b2e" stroke-width="1.8" stroke-linejoin="round"/><path d="M8.6 10l2.4 2.4 4.4-4.6" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <h3>They confirm with you</h3>
            <p>Leaps of Laughter reaches out to confirm the details with you.</p>
          </li>
        </ol>
      </div>
    </section>

    <!-- SERVICE AREAS -->
    <section class="section sec-areas edge-top" id="areas" aria-labelledby="areas-h">
      <div class="container areas">
        <div class="areas-copy reveal">
          <p class="eyebrow-pill eyebrow-pill-navy">Where we go</p>
          <h2 id="areas-h">Service areas</h2>
          <p class="sub">Based in {business.city}, serving these areas:</p>
          <ul class="area-chips">
            {serviceAreas.map((a, i) => <li style={`--i:${i}`}>{a}</li>)}
          </ul>
        </div>
        <div class="areas-photo reveal">
          <Image
            src={bandPhoto}
            alt="A Happy Birthday banner hung between two posts under string lights at an outdoor party"
            widths={[360, 540, 720]}
            sizes="(min-width: 900px) 460px, 92vw"
            format="webp"
            quality={66}
            loading="lazy"
            decoding="async"
          />
          <Confetti />
        </div>
      </div>
    </section>

    <!-- REQUEST FORM -->
    <section class="section sec-request edge-top" id="request" aria-labelledby="request-h">
      <div class="container req-grid">
        <div class="req-intro reveal">
          <p class="eyebrow-pill eyebrow-pill-dark">Request a date</p>
          <h2 id="request-h" tabindex="-1">Tell us about your <span class="mark">party</span></h2>
          <p class="sub">Add your rentals, share your date and ZIP, and send it. This is a demo, so nothing you type here is sent anywhere.</p>
          <div class="talk">
            <p class="talk-title">Prefer to talk?</p>
            <ul>
              {contacts.map((c) => <li><a href={`tel:${c.tel}`}><span>{c.name}</span> <b>{c.phone}</b></a></li>)}
            </ul>
          </div>
        </div>

        <div class="req-card reveal">
          <form class="form" id="request-form" action="#request" method="post" autocomplete="on">
            <fieldset class="picked">
              <legend>Chosen items</legend>
              <p class="picked-empty" id="picked-empty">Nothing added yet. <a href="#rentals">Pick a rental</a> and it will show up here.</p>
              <ul class="picked-list" id="picked-list"></ul>
              <input type="hidden" name="items" id="items-field" value="" />
            </fieldset>

            <div class="fields">
              <div class="field">
                <label for="f-name">Your name <span class="req" aria-hidden="true">*</span></label>
                <input id="f-name" name="name" type="text" autocomplete="name" required />
              </div>
              <div class="field">
                <label for="f-phone">Phone <span class="req" aria-hidden="true">*</span></label>
                <input id="f-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" required />
              </div>
              <div class="field field-wide">
                <label for="f-email">Email</label>
                <input id="f-email" name="email" type="email" autocomplete="email" />
              </div>
              <div class="field">
                <label for="f-date">Event date <span class="req" aria-hidden="true">*</span></label>
                <input id="f-date" name="date" type="date" required />
              </div>
              <div class="field">
                <label for="f-zip">ZIP code</label>
                <input id="f-zip" name="zip" type="text" inputmode="numeric" pattern="[0-9]{5}" maxlength="5" autocomplete="postal-code" title="5-digit ZIP code" />
              </div>
              <div class="field field-wide">
                <label for="f-notes">Notes</label>
                <textarea id="f-notes" name="notes" rows="4"></textarea>
              </div>
            </div>
            <p class="form-hint"><span class="req" aria-hidden="true">*</span> Required</p>
            <button type="submit" class="btn btn-yellow btn-lg btn-block">Send my request</button>
          </form>

          <div class="confirm" id="confirm" tabindex="-1" role="status" hidden>
            <div class="confirm-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="34" height="34"><path d="M5 12.5l4.5 4.5L19 7.5" fill="none" stroke="#1a0b2e" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </div>
            <h3 id="confirm-title">Thanks! Your request is ready.</h3>
            <p class="confirm-demo"><strong>Demo:</strong> in the live version this request goes straight to Leaps of Laughter.</p>
            <dl class="confirm-summary" id="confirm-summary"></dl>
            <button type="button" class="btn btn-outline" id="restart">Start a new request</button>
          </div>
        </div>
      </div>
    </section>

    <!-- CONTACT -->
    <section class="section sec-contact edge-top" id="contact" aria-labelledby="contact-h">
      <div class="container">
        <div class="section-head reveal">
          <p class="eyebrow-pill">Talk to a person</p>
          <h2 id="contact-h">Contact</h2>
          <p class="sub sub-light">Hours: {business.hours}</p>
        </div>
        <div class="contact-grid">
          {contacts.map((c, i) => (
            <div class={`contact-card reveal ${i === 0 ? 'cc-yellow' : 'cc-cyan'}`}>
              <p class="tag">{c.area}</p>
              <h3>{c.name}</h3>
              <a class="btn btn-navy" href={`tel:${c.tel}`}>
                <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M6.6 3.5l2.7 4-1.7 1.9a12 12 0 0 0 6.9 6.9l1.9-1.7 4 2.7-.9 3.3c-.2.8-.9 1.3-1.7 1.3C10.9 21.9 2.1 13.1 2.1 6.1c0-.8.5-1.5 1.3-1.7z" fill="currentColor"/></svg>
                <span>{c.phone}</span>
              </a>
            </div>
          ))}
          <div class="contact-card contact-card-wide reveal cc-white">
            <p class="tag">Message us</p>
            <h3>Email or WhatsApp</h3>
            <p><a class="contact-link" href={`mailto:${business.email}`}>{business.email}</a></p>
            <p class="cta-row">
              <a class="btn btn-navy" href={business.whatsapp} target="_blank" rel="noopener noreferrer">WhatsApp us<span class="sr-only"> (opens in a new tab)</span></a>
            </p>
            <address>{business.name}<br />{business.address}</address>
          </div>
        </div>
      </div>
    </section>
  </main>

  <!-- FOOTER -->
  <footer class="footer">
    <div class="container footer-inner">
      <p class="footer-word" aria-hidden="true">Leaps of Laughter</p>
      <p class="footer-brand">{business.name}</p>
      <p class="footer-tag">{business.tagline}</p>
      <p class="footer-credit">Sample photos from <a href="https://unsplash.com" target="_blank" rel="noopener noreferrer">Unsplash</a>. Illustrations are placeholders.</p>
      <p class="footer-quiet">Demo by Hopbook · <a href="mailto:muhammadkhalid48734@gmail.com">muhammadkhalid48734@gmail.com</a></p>
    </div>
  </footer>

  <!-- MY REQUEST BAR -->
  <aside class="request-bar" id="request-bar" aria-label="My request" inert>
    <div class="bar-thumbs" id="bar-thumbs" aria-hidden="true"></div>
    <div class="request-bar-text">
      <p class="request-bar-title">My request (<span id="bar-count">0</span>)</p>
      <p class="request-bar-items" id="bar-items"></p>
    </div>
    <button type="button" class="btn btn-yellow btn-sm" id="bar-open">Review request</button>
  </aside>
  <p class="sr-only" id="request-live" role="status" aria-live="polite"></p>

  <script>
    import '../scripts/request.js';
  </script>
</Base>
